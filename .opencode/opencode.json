{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek API",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}" 
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "description": "思考模式, 最大上下文 1M, 最大输出 384K",
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "options": {
            "thinking": {
              "type": "enabled"
            },
            "reasoning_effort": "max"
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "description": "思考模式, 最大上下文 1M, 最大输出 384K",
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "options": {
            "thinking": {
              "type": "enabled"
            },
            "reasoning_effort": "max"
          }
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  }
}